<https://w3id.org/mouseclaimbench/shape/bounded_predictive_performance-context_of_use-metadata> a sh:NodeShape ;
    sh:sparql [ sh:message "missing source, rule, or rationale: context_of_use" ;
            sh:select """SELECT $this WHERE {
  $this <https://w3id.org/mouseclaimbench/hasEvidence> ?fact .
  ?fact <https://w3id.org/mouseclaimbench/blockName> "context_of_use" .
  FILTER NOT EXISTS {
    ?fact <https://w3id.org/mouseclaimbench/source> ?source .
    ?fact <https://w3id.org/mouseclaimbench/rule> ?rule .
    ?fact <https://w3id.org/mouseclaimbench/rationale> ?rationale .
  }
}""" ] ;
    sh:targetNode <https://w3id.org/mouseclaimbench/package/bounded_predictive_performance__pristine> ;
    mcb:blockName "context_of_use" ;
    mcb:deficitCode "missing_fact_metadata" .

