    {
      "id": "profile_support_is_not_scientific_truth",
      "severity": "critical",
      "affected_items": [
        "rule__all_requirements_satisfied"
      ],
      "finding": "The executable conclusion 'supported' can be read as scientific support, while the relation basis repeatedly says that requirements are sufficient only for profile authorization or are not scientifically sufficient.",
      "required_action": "Rename the conclusion to profile_supported or add an unavoidable scope qualifier to every exported decision and manuscript statement."
    },
    {
      "id": "mechanistic_sufficiency_gap",
      "severity": "major",
      "affected_claims": [
        "mechanistic"
      ],
      "finding": "Prediction, internal reproduction, topology specificity, and observational direction do not jointly establish mechanism without perturbational discrimination, parameter or structural identifiability, uncertainty, and competing-mechanism analysis.",
      "required_action": "Narrow the claim to directed_topology_consistent_prediction or add dedicated mechanistic intervention, identifiability, and alternative-model blocks."
    },
    {
      "id": "generic_digital_twin_label_mismatch",
      "severity": "major",
      "affected_claims": [
        "digital_twin"
      ],
      "finding": "The generic claim identifier is evaluated using requirements for a complete, causal, entity-specific, whole-brain and operational twin. This is safer than under-restriction but obscures the construct and rejects partial twins.",
      "required_action": "Rename the claim to complete_entity_specific_mouse_brain_digital_twin and define separate partial-model or prototype claims if needed."
    },
    {
